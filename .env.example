# 1. Supabase Project URL (Vào Supabase Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Vào Supabase Dashboard -> Project Settings -> API -> anon public)
# QUAN TRỌNG: Chỉ dùng Anon Key, tuyệt đối KHÔNG đưa Service Role Key lên Client!
VITE_SUPABASE_ANON_KEY=your-anon-key-here

